# Public app URL used for bot webhooks and ЮKassa return URLs.
# Use https in production. Local demo can keep localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Leave empty to run the in-memory demo (Slot Studio).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant. OpenAI-compatible API (DeepSeek by default).
# OPENAI_API_KEY is a fallback if AI_API_KEY is empty.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
OPENAI_API_KEY=

# ЮKassa subscriptions
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set to 1 only for local webhook tests. Never enable in production.
YOOKASSA_ALLOW_IP_BYPASS=

# Daily subscription renewal: GET/POST /api/cron/renew-subscriptions
CRON_SECRET=

# Optional Redis rate limiter. Without it the app uses in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Landing contact form delivery via the owner's MAX bot.
CONTACT_BUSINESS_ID=
CONTACT_MAX_USER_ID=
