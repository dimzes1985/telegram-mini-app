# Public app URL used for bot webhooks and ЮKassa return URLs.
# Use https in production. Local demo can keep localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Leave empty to run the in-memory demo (Slot Studio).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant. OpenAI-compatible API (DeepSeek by default).
# OPENAI_API_KEY is a fallback if AI_API_KEY is empty.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
OPENAI_API_KEY=

# ЮKassa subscriptions
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set to 1 only for local webhook tests. Never enable in production.
YOOKASSA_ALLOW_IP_BYPASS=

# Daily subscription renewal: GET/POST /api/cron/renew-subscriptions
CRON_SECRET=

# Optional Redis rate limiter. Without it the app uses in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Landing contact form delivery via the owner's MAX bot.
CONTACT_BUSINESS_ID=
CONTACT_MAX_USER_ID=

# Business-local calendar time (shared default for this deployment).
BUSINESS_TIMEZONE=Europe/Moscow

# Compatible Redis REST aliases used by the self-hosted gateway.
# Configure either these OR UPSTASH_REDIS_REST_* consistently.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# SMTP delivery / password reset.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Owner web push. Generate securely; do not rotate without a resubscribe plan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional monitoring and analytics; NEXT_PUBLIC_* are build-time public data.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_YM_ID=

# Operator / support details (set to the buyer's details on transfer).
SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_INN=
NEXT_PUBLIC_LEGAL_EMAIL=

# Optional Telegram Bot API gateway; empty uses api.telegram.org.
TELEGRAM_API_URL=

# Image metadata: supplied by the deployment build.
APP_VERSION=unknown
